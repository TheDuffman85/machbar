# Public origin only, without a path. For development with Vite use http://localhost:5173.
APP_URL=http://localhost:3000
HOST_PORT=3000
BIND_ADDRESS=0.0.0.0
# Daily page: how many days before today can be selected (0 disables past-day navigation).
DAILY_HISTORY_DAYS=3
# Visitors can create profiles by default and consume shared quotas.
# Set true to require locally provisioned profiles (see README).
DISABLE_USER_CREATION=false
# Optional Web Push. Generate matching keys once (see README); keep them stable.
# All three values are required to enable habit notifications.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Optional hidden admin page at /admin (password login). Set the hash to enable it.
# Generate the hash with hash-admin-password.js (see README) and serve the app over HTTPS.
# ADMIN_PASSWORD_HASH=scrypt:15:8:1:...
# Minimum password length accepted by hash-admin-password.js.
# ADMIN_PASSWORD_MIN_LENGTH=12
# API requests per fixed window (seconds). Missing/invalid IDs share the anonymous IP limit.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_PER_IP=300
RATE_LIMIT_MAX_PER_USER=120
RATE_LIMIT_MAX_ANONYMOUS=20
# New-profile sync attempts per window, shared globally across IPs and UUIDs.
RATE_LIMIT_MAX_NEW_USERS=10
# Comma-separated reverse-proxy IPs/CIDRs; empty ignores forwarding headers.
# Trust only your proxies, which must replace client-supplied forwarding headers.
TRUSTED_PROXIES=
# Persistent quotas; profile and push payloads in SQLite share the byte budget.
MAX_PROFILES=100
MAX_STORAGE_BYTES=268435456
# Keep 64 MiB free on the data filesystem, plus room for SQLite pages and rollback journals.
STORAGE_RESERVE_BYTES=67108864
# Local development/server only (Docker uses /app/data and /app/web).
# DATA_DIR=./data
# WEB_DIR=./apps/web/dist
