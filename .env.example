# Public origin only, without a path. For development with Vite use http://localhost:5173.
APP_URL=http://localhost:3000
HOST_PORT=3000
BIND_ADDRESS=0.0.0.0
# Daily page: how many days before today can be selected (0 disables past-day navigation).
DAILY_HISTORY_DAYS=3
# Reject new profiles; visitors must enter or scan an existing saved user ID.
DISABLE_USER_CREATION=false
# API requests per fixed window (seconds). Missing/invalid IDs share the anonymous IP limit.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_PER_IP=300
RATE_LIMIT_MAX_PER_USER=120
RATE_LIMIT_MAX_ANONYMOUS=20
# Local development/server only (Docker uses /app/data and /app/web).
# DATA_DIR=./data
# WEB_DIR=./apps/web/dist
