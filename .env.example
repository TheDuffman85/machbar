# Public origin only, without a path. For development with Vite use http://localhost:5173.
APP_URL=http://localhost:3000
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
HOST_PORT=3000
BIND_ADDRESS=0.0.0.0
# All three optional OIDC settings must be configured together.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Local development/server only (Docker uses /app/data and /app/web).
# DATA_DIR=./data
# WEB_DIR=./apps/web/dist
