{
  "name": "machbar",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "dev": "pnpm --filter @machbar/shared build && concurrently -k -n shared,api,web 'pnpm --filter @machbar/shared dev' 'pnpm --filter @machbar/api dev' 'pnpm --filter @machbar/web dev'",
    "build": "pnpm --filter @machbar/shared build && pnpm --filter @machbar/api build && pnpm --filter @machbar/web build",
    "start": "node apps/api/dist/index.js",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @machbar/shared build && vitest run",
    "test:e2e": "playwright test",
    "test:docker": "node scripts/test-docker.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
